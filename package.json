{
  "name": "fastdetailing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-public-assets.mjs && next dev",
    "build": "node scripts/sync-public-assets.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/check-database.mjs",
    "db:backup": "node scripts/backup-database.mjs",
    "db:restore": "node scripts/restore-database.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "cheerio": "^1.1.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.2"
  }
}
